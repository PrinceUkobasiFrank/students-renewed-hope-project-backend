const { Pool } = require('pg');

// Railway's Postgres plugin auto-injects DATABASE_URL when you add it to
// your project — no manual connection-string assembly needed. This works
// the same regardless of host (Railway, a local Postgres, or anything else).
const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
  ssl: process.env.DB_SSL === 'true' ? { rejectUnauthorized: false } : false
});

pool.on('error', (err) => {
  console.error('Unexpected error on idle Postgres client', err);
});

module.exports = pool;
