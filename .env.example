# Copy this file to .env for local development.
# On Railway, set these as environment variables in your service's Variables
# tab instead — don't deploy a .env file.

# Local Postgres example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/srhp
#
# On Railway: add a Postgres plugin to your project and it auto-injects
# DATABASE_URL into your service's environment — you don't set this by hand.
DATABASE_URL=

# Railway's internal Postgres connection does not need SSL. Set to "true"
# only if you're connecting to a Postgres instance that requires it
# (e.g. some external/public connections).
DB_SSL=false

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=8080

# Comma-separated list of allowed origins for the frontend, e.g.:
# CORS_ORIGIN=https://your-frontend.pages.dev,http://localhost:5500
CORS_ORIGIN=*

# Your deployed frontend's base URL — used to build real links inside the
# welcome email (dashboard, card generator). No trailing slash.
FRONTEND_URL=http://localhost:5500

# Required for welcome emails on registration — see "Email" section in README.
# Sign up at resend.com (free tier: 3,000 emails/month), create an API key.
RESEND_API_KEY=
# Must be a verified sender. Resend gives you a shared onboarding@resend.dev
# address that works immediately with no setup, for testing. Switch to
# hello@studentsrenewedhope.com.ng once that domain is verified in Resend.
EMAIL_FROM=Students Renewed Hope Project <onboarding@resend.dev>
